@using SocOps.Models

<button
    @onclick="OnClick"
    disabled="@Square.IsFreeSpace"
    class="@GetCssClasses()"
    aria-pressed="@Square.IsMarked"
    aria-label="@(Square.IsFreeSpace ? "Free space" : Square.Text)">
    <span>@Square.Text</span>
    @if (Square.IsMarked && !Square.IsFreeSpace)
    {
        <span class="bingo-square-check">●</span>
    }
</button>

@code {
    [Parameter]
    public BingoSquareData Square { get; set; } = null!;

    [Parameter]
    public bool IsWinning { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    private string GetCssClasses()
    {
        var classes = "bingo-square";

        if (Square.IsFreeSpace)
        {
            classes += " bingo-square--free";
        }
        else if (IsWinning && Square.IsMarked)
        {
            classes += " bingo-square--winning";
        }
        else if (Square.IsMarked)
        {
            classes += " bingo-square--marked";
        }

        return classes;
    }
}
