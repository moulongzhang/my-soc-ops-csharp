<div class="start-screen">
    <div class="start-content">
        <h1 class="start-title">Soc Ops</h1>
        <p class="start-subtitle">social bingo</p>

        <div class="start-rules">
            <span class="start-rules-label">How to play</span>
            <ul>
                <li>Find people who match the descriptions</li>
                <li>Tap a square when you find a match</li>
                <li>Complete five in a row to win</li>
            </ul>
        </div>

        <button class="start-btn" @onclick="OnStart">
            Begin
        </button>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnStart { get; set; }
}
