@using SocOps.Models

<div class="game-screen">
    <header class="game-header">
        <button class="game-back-btn" @onclick="OnReset">
            ‹ back
        </button>
        <h1 class="game-title">Soc Ops</h1>
        <div class="game-header-spacer"></div>
    </header>

    <p class="game-instructions">
        tap a square when you find someone who matches
    </p>

    @if (HasBingo)
    {
        <div class="game-bingo-banner">
            bingo — you completed a line
        </div>
    }

    <div class="game-board-area">
        <BingoBoard
            Board="@Board"
            WinningSquareIds="@WinningSquareIds"
            OnSquareClick="@OnSquareClick" />
    </div>
</div>

@code {
    [Parameter]
    public List<BingoSquareData> Board { get; set; } = new();

    [Parameter]
    public HashSet<int> WinningSquareIds { get; set; } = new();

    [Parameter]
    public bool HasBingo { get; set; }

    [Parameter]
    public EventCallback<int> OnSquareClick { get; set; }

    [Parameter]
    public EventCallback OnReset { get; set; }
}
